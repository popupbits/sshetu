<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The permission this app exists to use.

      Flutter's template declares INTERNET only in the debug and profile
      manifests, because what needs it there is the Dart VM service rather
      than the app. That is a sensible default for an app that talks to
      nothing, and exactly wrong for an SSH client: a release build inherits
      no INTERNET permission and cannot open a socket at all. Every debug
      run works, the shipped app reports "cannot reach host" for every
      server, and nothing in the code is wrong.

      Found on an emulator, by installing a release build and watching it
      fail to reach a server a debug build had just connected to.
      Guarded by test/android_manifest_test.dart.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Scanning the QR code another device shows. Requested at the moment the
      scanner opens and never before, and the app is fully usable without it —
      a device can always receive by pasting the code as text instead.
    -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!--
      The optional credential lock (Settings → Security), off by default. It
      asks for a fingerprint or face through BiometricPrompt, which also
      offers the device PIN, so no user is ever locked out by a sensor.
      Guarded by test/android_manifest_test.dart.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!--
      Keeping connections alive in the background (Settings → Terminal, on by
      default). Android freezes or kills a backgrounded app within minutes,
      and every SSH socket with it; KeepAliveService is a foreground service
      that runs only while a session or tunnel is open. Its type is
      specialUse — see the service below, and PROJECT.md for the Play Console
      declaration it needs. WAKE_LOCK keeps the CPU running the isolate with
      the screen off. POST_NOTIFICATIONS is asked for at the first connection,
      never at launch; the service runs whether or not it is granted.
      Guarded by test/android_manifest_test.dart.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      The label is "SSHetu", set in build.gradle.kts; a debug build is
      "SSHetu Debug", a separate app with its own data. See PROJECT.md,
      "Debug builds have their own identity".
    -->
    <!--
      Nothing this app stores leaves the device unless the user sends it.

      `allowBackup="false"` keeps the database, the preferences and the
      encrypted credential store out of Google Drive backup; the extraction
      rules keep them out of the Android 12+ device-to-device transfer, which
      `allowBackup` does not cover. The reasoning — privacy, and a restored
      host list whose credentials cannot be decrypted on the new device — is
      in res/xml/data_extraction_rules.xml. Moving to a new device is
      Settings → Backup or Send to a device, both of which carry the secrets
      and both of which the user chooses.

      Guarded by test/android_manifest_test.dart.
    -->
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          Holds the process in the foreground while connections are open. Not
          exported: only this app's own notification and activity start it.
          The subtype is read by Play review, not by Android.
        -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-opened interactive SSH terminal sessions and SSH port forwards connected while the app is in the background. Runs only while a connection the user opened is active; stops when the last one closes or the user taps Disconnect all."/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
