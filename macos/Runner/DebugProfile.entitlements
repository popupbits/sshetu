<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Outgoing connections. Without this an SSH client cannot open a single
	     socket: the sandbox denies connect() and every host looks unreachable.
	     Flutter's template omits it, which is fine for an app that talks to an
	     HTTP API through a plugin, and fatal here. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Local port forwarding binds a listening socket on this machine. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- The OpenSSH import reads a folder the user picks. Under the sandbox
	     ~/.ssh cannot be reached any other way — Directory.existsSync() simply
	     returns false, verified on this build — and it should not be: that
	     folder holds every key they own, so opening it is a decision made in a
	     file panel, not one an app takes by itself.
	
	     Deliberately NOT `keychain-access-groups`. See KeychainSecretVault:
	     that entitlement requires a DEVELOPMENT_TEAM, and it is only needed for
	     the macOS data-protection keychain, which this app does not use. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
