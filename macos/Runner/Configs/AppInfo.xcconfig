// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// The human-facing name: the macOS menu bar, the About panel and the
// bundle all take this. `flutter create` seeds it from the Dart package
// name, which is an identifier and not a name — so this is set by hand and
// capitalised the way the product is written.
PRODUCT_NAME = SSHetu

// The name in the menu bar and the About panel. Release and Profile: the
// product name, exactly as before. The Runner target's Debug configuration
// sets "SSHetu Debug" and its own bundle id (com.popupbits.sshetu.debug),
// so a debug build is a separate app with its own sandbox container and
// preferences. See PROJECT.md, "Debug builds have their own identity".
APP_DISPLAY_NAME = $(PRODUCT_NAME)

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.popupbits.sshetu

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 PopupBits. All rights reserved.
