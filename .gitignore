# ---------------------------------------------------------------
# Release signing and store credentials — NEVER COMMIT THESE
# ---------------------------------------------------------------
.env.android
.env.android.codemagic
.env.ios
.env.ios.codemagic
/android/.env.android
android/key.properties
android/keystore/*.jks
android/keystore/*.keystore
android/app/**/*.jks
android/app/**/*.keystore

# Bundler / fastlane
android/vendor/bundle
android/.bundle/
ios/vendor/bundle
ios/.bundle/
android/fastlane/report.xml
android/fastlane/README.md
ios/fastlane/report.xml
ios/fastlane/README.md

# Store screenshots are regenerated by `flutter drive`.
/build/screenshots/

# A path dependency resolves against the app lockfile; its own is noise.
packages/*/pubspec.lock

# Agent worktrees: separate checkouts, never part of this one.
.claude/worktrees/

# App Store review contact details. `deliver` uploads these verbatim, so they
# carry a real person's name, email and phone — which a public repository
# would publish. The owner (or the release job) writes the real files from the
# `.example` templates beside them before `fastlane release` runs; see
# RELEASE_READINESS.md § "App Store review contact".
ios/fastlane/metadata/review_information/first_name.txt
ios/fastlane/metadata/review_information/last_name.txt
ios/fastlane/metadata/review_information/email_address.txt
ios/fastlane/metadata/review_information/phone_number.txt
ios/fastlane/metadata/review_information/demo_user.txt
ios/fastlane/metadata/review_information/demo_password.txt

# A vendored package builds its own test assets; they are not sources.
packages/*/build/

# Distributables. Built by tool/package_linux.dart, tool/make_installer.ps1
# and tool/make_dmg.sh, attached to a GitHub release, never committed.
/dist/
/windows/installer/output/
